import React, { useCallback, useEffect, useMemo, useState } from "react";
import axios from "axios";
import {
  HelpCircle,
  Plus,
  Pencil,
  Trash2,
  Search,
  RefreshCw,
  Sparkles,
  X,
  Loader2,
  CheckCircle2,
  AlertCircle,
  ChevronDown,
  ChevronUp,
  ShieldAlert,
} from "lucide-react";

/* =========================================================
   MANAGE FAQs — Admin / SuperAdmin only
   Backend (src/routes/supportRoutes.js):
     GET    /api/support/faqs          list (any logged-in user)
     POST   /api/support/faqs          create   { question, answer }  Admin/SuperAdmin
     POST   /api/support/faqs/seed     default FAQs (only when empty)
     PUT    /api/support/faqs/:id      update   { question, answer }
     DELETE /api/support/faqs/:id      delete
========================================================= */

const FAQ_PATH = "/support/faqs";

const API_BASE =
  String(import.meta.env.VITE_API_URL || "https://task-backend-mn8a.onrender.com")
    .trim()
    .replace(/\/+$/, "")
    .replace(/\/api$/, "") + "/api";

const getAuthToken = () =>
  (
    localStorage.getItem("token") ||
    localStorage.getItem("authToken") ||
    localStorage.getItem("accessToken") ||
    ""
  ).replace(/^"|"$/g, "");

const getSessionUser = () => {
  try {
    const raw = JSON.parse(localStorage.getItem("user") || "null");
    return raw?.user && !raw.role ? raw.user : raw;
  } catch {
    return null;
  }
};

const api = axios.create({ baseURL: API_BASE, withCredentials: false });

api.interceptors.request.use((config) => {
  const token = getAuthToken();
  if (token) {
    config.headers = config.headers || {};
    config.headers.Authorization = `Bearer ${token}`;
  }
  return config;
});

const extractList = (response) => {
  const body = response?.data;
  if (Array.isArray(body)) return body;
  if (Array.isArray(body?.data)) return body.data;
  if (Array.isArray(body?.faqs)) return body.faqs;
  if (Array.isArray(body?.data?.faqs)) return body.data.faqs;
  return [];
};

const errorText = (err, fallback) => {
  const status = err?.response?.status;
  if (status === 401) return "Session expired. Please log in again.";
  if (status === 403) return "You don't have permission to manage FAQs.";
  if (status === 404)
    return `FAQ route not found (${err?.config?.method?.toUpperCase()} ${API_BASE}${err?.config?.url}). Check where faqRoutes is mounted.`;
  if (!err?.response) return "Cannot reach the server. It may be waking up — please retry.";
  return err?.response?.data?.message || fallback;
};

const emptyForm = { question: "", answer: "" };

const ManageFaqs = () => {
  const [sessionUser] = useState(getSessionUser);
  const isAdmin = ["SuperAdmin", "Admin"].includes(sessionUser?.role);

  const [faqs, setFaqs] = useState([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");
  const [toast, setToast] = useState(null);
  const [search, setSearch] = useState("");
  const [openId, setOpenId] = useState(null);

  const [showModal, setShowModal] = useState(false);
  const [editing, setEditing] = useState(null);
  const [form, setForm] = useState(emptyForm);
  const [saving, setSaving] = useState(false);
  const [formError, setFormError] = useState("");

  const [deleteTarget, setDeleteTarget] = useState(null);
  const [deleting, setDeleting] = useState(false);
  const [seeding, setSeeding] = useState(false);

  const showToast = (message, type = "success") => {
    setToast({ message, type });
    setTimeout(() => setToast(null), 3200);
  };

  const loadFaqs = useCallback(async () => {
    setLoading(true);
    setError("");
    try {
      const res = await api.get(FAQ_PATH);
      setFaqs(extractList(res));
    } catch (err) {
      setError(errorText(err, "Unable to load FAQs."));
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => {
    if (isAdmin) loadFaqs();
    else setLoading(false);
  }, [isAdmin, loadFaqs]);

  const filtered = useMemo(() => {
    const q = search.trim().toLowerCase();
    if (!q) return faqs;
    return faqs.filter((f) =>
      `${f.question || ""} ${f.answer || ""}`.toLowerCase().includes(q)
    );
  }, [faqs, search]);

  const openCreate = () => {
    setEditing(null);
    setForm(emptyForm);
    setFormError("");
    setShowModal(true);
  };

  const openEdit = (faq) => {
    setEditing(faq);
    setForm({
      question: faq.question || "",
      answer: faq.answer || "",
    });
    setFormError("");
    setShowModal(true);
  };

  const saveFaq = async (e) => {
    e.preventDefault();
    if (saving) return;
    if (!form.question.trim() || !form.answer.trim()) {
      setFormError("Please enter both a question and an answer.");
      return;
    }
    setSaving(true);
    setFormError("");
    const payload = {
      question: form.question.trim(),
      answer: form.answer.trim(),
    };
    try {
      if (editing) {
        await api.put(`${FAQ_PATH}/${editing._id || editing.id}`, payload);
        showToast("FAQ updated.");
      } else {
        await api.post(FAQ_PATH, payload);
        showToast("FAQ added.");
      }
      setShowModal(false);
      await loadFaqs();
    } catch (err) {
      setFormError(errorText(err, "Could not save the FAQ."));
    } finally {
      setSaving(false);
    }
  };

  const confirmDelete = async () => {
    if (!deleteTarget || deleting) return;
    setDeleting(true);
    try {
      await api.delete(`${FAQ_PATH}/${deleteTarget._id || deleteTarget.id}`);
      setFaqs((prev) => prev.filter((f) => (f._id || f.id) !== (deleteTarget._id || deleteTarget.id)));
      showToast("FAQ deleted.");
      setDeleteTarget(null);
    } catch (err) {
      showToast(errorText(err, "Could not delete the FAQ."), "error");
    } finally {
      setDeleting(false);
    }
  };

  const seedSamples = async () => {
    if (seeding) return;
    setSeeding(true);
    try {
      const res = await api.post(`${FAQ_PATH}/seed`);
      showToast(res.data?.message || "Sample FAQs loaded.");
      await loadFaqs();
    } catch (err) {
      showToast(errorText(err, "Could not load sample FAQs."), "error");
    } finally {
      setSeeding(false);
    }
  };

  /* ---------------- not allowed ---------------- */
  if (!isAdmin) {
    return (
      <div className="faq-admin">
        <style>{css}</style>
        <div className="faq-shell">
          <div className="faq-empty">
            <div className="faq-empty-icon"><ShieldAlert size={26} /></div>
            <h3>Admins only</h3>
            <p>Only Admin and Super Admin accounts can manage FAQs.</p>
          </div>
        </div>
      </div>
    );
  }

  return (
    <div className="faq-admin">
      <style>{css}</style>

      <div className="faq-shell">
        {/* HERO */}
        <header className="faq-hero">
          <div className="faq-hero-left">
            <div className="faq-hero-icon"><HelpCircle size={24} /></div>
            <div>
              <h1>Manage FAQs</h1>
              <p>Add, edit and remove the questions shown on the Support page.</p>
            </div>
          </div>
          <div className="faq-hero-actions">
            <button type="button" className="faq-btn ghost" onClick={seedSamples} disabled={seeding}>
              {seeding ? <Loader2 size={15} className="spin" /> : <Sparkles size={15} />}
              {seeding ? "Loading…" : "Load samples"}
            </button>
            <button type="button" className="faq-btn primary" onClick={openCreate}>
              <Plus size={16} /> Add FAQ
            </button>
          </div>
        </header>

        {/* TOOLBAR */}
        <div className="faq-toolbar">
          <div className="faq-search">
            <Search size={16} />
            <input
              placeholder="Search questions or answers…"
              value={search}
              onChange={(e) => setSearch(e.target.value)}
            />
          </div>
          <button type="button" className="faq-btn outline" onClick={loadFaqs} disabled={loading}>
            <RefreshCw size={14} className={loading ? "spin" : ""} /> Refresh
          </button>
          <span className="faq-count">{filtered.length} of {faqs.length} FAQs</span>
        </div>

        {/* LIST */}
        <section className="faq-panel">
          {loading ? (
            <div className="faq-state"><Loader2 size={20} className="spin" /> Loading FAQs…</div>
          ) : error ? (
            <div className="faq-state error">
              <AlertCircle size={18} />
              <span>{error}</span>
              <button type="button" className="faq-btn outline" onClick={loadFaqs}>Retry</button>
            </div>
          ) : filtered.length === 0 ? (
            <div className="faq-empty">
              <div className="faq-empty-icon"><HelpCircle size={26} /></div>
              <h3>{faqs.length ? "No FAQs match your search" : "No FAQs yet"}</h3>
              <p>
                {faqs.length
                  ? "Try a different search."
                  : "Add your first FAQ, or click “Load samples” to add the default FAQs."}
              </p>
              {!faqs.length && (
                <button type="button" className="faq-btn primary" onClick={openCreate}>
                  <Plus size={15} /> Add FAQ
                </button>
              )}
            </div>
          ) : (
            filtered.map((faq) => {
              const id = faq._id || faq.id;
              const open = openId === id;
              return (
                <article key={id} className="faq-row">
                  <button type="button" className="faq-q" onClick={() => setOpenId(open ? null : id)}>
                    <span className="faq-q-text">{faq.question}</span>
                    {open ? <ChevronUp size={17} /> : <ChevronDown size={17} />}
                  </button>
                  {open && <div className="faq-a">{faq.answer}</div>}
                  <div className="faq-actions">
                    <button type="button" className="faq-icon" title="Edit" onClick={() => openEdit(faq)}>
                      <Pencil size={14} />
                    </button>
                    <button type="button" className="faq-icon danger" title="Delete" onClick={() => setDeleteTarget(faq)}>
                      <Trash2 size={14} />
                    </button>
                  </div>
                </article>
              );
            })
          )}
        </section>
      </div>

      {/* ADD / EDIT MODAL */}
      {showModal && (
        <div className="faq-overlay" onMouseDown={(e) => e.target === e.currentTarget && !saving && setShowModal(false)}>
          <form className="faq-modal" onSubmit={saveFaq}>
            <div className="faq-modal-head">
              <h2>{editing ? "Edit FAQ" : "Add FAQ"}</h2>
              <button type="button" className="faq-icon" onClick={() => setShowModal(false)} disabled={saving}>
                <X size={16} />
              </button>
            </div>

            <div className="faq-modal-body">
              <label className="faq-field">
                <span>Question *</span>
                <input
                  value={form.question}
                  onChange={(e) => setForm({ ...form, question: e.target.value })}
                  placeholder="e.g. How do I create a task?"
                  maxLength={300}
                  autoFocus
                />
              </label>

              <label className="faq-field">
                <span>Answer *</span>
                <textarea
                  value={form.answer}
                  onChange={(e) => setForm({ ...form, answer: e.target.value })}
                  placeholder="Write a clear, short answer…"
                  rows={6}
                  maxLength={5000}
                />
              </label>

              {formError && (
                <div className="faq-alert"><AlertCircle size={15} /> {formError}</div>
              )}
            </div>

            <div className="faq-modal-foot">
              <button type="button" className="faq-btn outline" onClick={() => setShowModal(false)} disabled={saving}>
                Cancel
              </button>
              <button type="submit" className="faq-btn primary" disabled={saving}>
                {saving ? <Loader2 size={15} className="spin" /> : editing ? <Pencil size={15} /> : <Plus size={15} />}
                {saving ? "Saving…" : editing ? "Save changes" : "Add FAQ"}
              </button>
            </div>
          </form>
        </div>
      )}

      {/* DELETE CONFIRM */}
      {deleteTarget && (
        <div className="faq-overlay" onMouseDown={(e) => e.target === e.currentTarget && !deleting && setDeleteTarget(null)}>
          <div className="faq-modal small">
            <div className="faq-del-icon"><Trash2 size={22} /></div>
            <h2 className="faq-del-title">Delete this FAQ?</h2>
            <p className="faq-del-text">“{deleteTarget.question}” will be removed from the Support page.</p>
            <div className="faq-modal-foot center">
              <button type="button" className="faq-btn outline" onClick={() => setDeleteTarget(null)} disabled={deleting}>
                Cancel
              </button>
              <button type="button" className="faq-btn danger" onClick={confirmDelete} disabled={deleting}>
                {deleting ? <Loader2 size={15} className="spin" /> : <Trash2 size={15} />}
                {deleting ? "Deleting…" : "Delete"}
              </button>
            </div>
          </div>
        </div>
      )}

      {toast && (
        <div className={`faq-toast ${toast.type}`}>
          {toast.type === "error" ? <AlertCircle size={15} /> : <CheckCircle2 size={15} />}
          {toast.message}
        </div>
      )}
    </div>
  );
};

